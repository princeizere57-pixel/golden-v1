# Copy to .env.local. Everything is optional: without keys the app runs on its deterministic
# engines and a demo Premium switch.

# Session signing (server-only). A long random string, e.g. `openssl rand -base64 32`. Signs the
# sign-in and plan cookies so nobody can edit them. Falls back to SUPABASE_SERVICE_ROLE_KEY.
SESSION_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TheMealDB. Leave empty to use the shared test key "1" (development only);
# a public or app-store release needs a supporter key from themealdb.com.
# TheMealDB supporter key (V2 API). Set it in Vercel; empty = V1 test key, development only.
MEALDB_API_KEY=

# Whop checkout. Webhook URL: https://<your-site>/api/billing/whop/webhook with events
# payment.succeeded, membership.activated and membership.updated; its signing secret (ws_...):
WHOP_WEBHOOK_SECRET=
# Embedded checkout (Whop Elements). The plan IDs are already in src/lib/billing/offers.ts
# (Executive plan_EJWuPToHk9nUw, Experience plan_2Tozpw2x8yzvn); set these only to override them. With an API key + company ID, offers without a plan ID and
# "Buy now, pay later" are created server-side as checkout configurations.
WHOP_PLAN_EXECUTIVE=
WHOP_PLAN_EXPERIENCE=
WHOP_API_KEY=
WHOP_COMPANY_ID=

# Gemini (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stripe: US entity (USD; card, Apple Pay, Google Pay)
STRIPE_US_SECRET_KEY=
STRIPE_US_WEBHOOK_SECRET=
STRIPE_US_PRICE_YEAR=
STRIPE_US_PRICE_MONTH=

# Stripe: UK entity (GBP; card, Pay by Bank). Webhook URL: /api/billing/stripe/webhook?entity=uk
STRIPE_UK_SECRET_KEY=
STRIPE_UK_WEBHOOK_SECRET=
STRIPE_UK_PRICE_YEAR=
STRIPE_UK_PRICE_MONTH=

# Apple App Store Server Notifications V2: /api/billing/app-store/notifications
APPLE_BUNDLE_ID=
# Optional override of the Apple Root CA - G3 SHA-256 fingerprint
APPLE_ROOT_CA_SHA256=

# Google Play RTDN (Pub/Sub push to /api/billing/google/rtdn?token=...)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_RTDN_TOKEN=


# Analytics (optional): PostHog project API key and host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
